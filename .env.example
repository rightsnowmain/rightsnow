# Application Environment Configuration
NODE_ENV=development
PORT=3000
FRONTEND_PORT=5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/news_publishing_db?schema=public"

# JWT Authentication
JWT_SECRET="super-secret-jwt-key-replace-in-production-min-32-chars"
JWT_EXPIRATION="15m"
REFRESH_TOKEN_SECRET="super-secret-refresh-key-replace-in-production"
REFRESH_TOKEN_EXPIRATION="7d"

# Legacy MySQL Data Source (For Import Scripts)
LEGACY_MYSQL_HOST=localhost
LEGACY_MYSQL_PORT=3306
LEGACY_MYSQL_USER=root
LEGACY_MYSQL_PASSWORD=pubz
LEGACY_MYSQL_DATABASE=rightsnow

# Storage / Media
STORAGE_DRIVER=local
UPLOAD_DESTINATION=./public/uploads
MAX_FILE_SIZE_MB=10

# Client URL (for CORS)
CLIENT_URL="http://localhost:5173"
